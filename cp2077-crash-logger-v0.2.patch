+                    out << "--- REDEngine CrashInfo.json ---\n";
+                    out << ReadTextCapped(crashInfo) << "\n--- end CrashInfo.json ---\n\n";
+                }
+            }
+
+            out << "TRACE POINTER\n"
+                   "  Also inspect CrashLogger_trace.log for the final first-chance exception/resource\n"
+                   "  breadcrumbs from the previous process.\n\n"
+                   "-- end of previous-session postmortem --\n";
+            out.flush();
+
+            std::error_code ec;
+            std::filesystem::remove(markerPath, ec);
+            REX::INFO("SessionRecovery: previous abnormal session -> {}", outPath.string());
+        }
+
+        void CreateCurrentMarker(const std::filesystem::path& sessions)
+        {
+            const DWORD pid = GetCurrentProcessId();
+            s_currentMarker = sessions / std::format("{}.active", pid);
+            std::ofstream out(s_currentMarker, std::ios::out | std::ios::trunc);
+            if (!out) {
+                s_currentMarker.clear();
+                return;
+            }
+            out << "version=1\n";
+            out << std::format("pid={}\n", pid);
+            out << std::format("started_filetime={}\n", FileTimeNow());
+            out << std::format("started_display={}\n", LogWriter::MakeDisplayTimestamp());
+            out.flush();
+        }
+    }
+
+    void Init()
+    {
+        try {
+            const auto sessions = LogWriter::GetLogDir() / "sessions";
+            std::error_code ec;
+            std::filesystem::create_directories(sessions, ec);
+
+            for (const auto& e : std::filesystem::directory_iterator(sessions, ec)) {
+                if (!e.is_regular_file(ec) || e.path().extension() != ".active")
+                    continue;
+                const Marker marker = ReadMarker(e.path());
+                if (!marker.pid || ProcessAlive(marker.pid))
+                    continue;
+                try {
+                    WritePostmortem(e.path(), marker);
+                } catch (const std::exception& ex) {
+                    REX::WARN("SessionRecovery: stale-session analysis failed for {}: {}",
+                        e.path().string(), ex.what());
+                }
+            }
+
+            CreateCurrentMarker(sessions);
+            if (!s_currentMarker.empty())
+                REX::INFO("SessionRecovery: armed {}", s_currentMarker.string());
+        } catch (const std::exception& e) {
+            REX::WARN("SessionRecovery: init failed: {}", e.what());
+        }
+    }
+
+    void MarkAbnormal() noexcept
+    {
+        s_abnormal.store(true, std::memory_order_relaxed);
+    }
+
+    void MarkCleanExit() noexcept
+    {
+        if (s_abnormal.load(std::memory_order_relaxed))
+            return;
+        try {
+            if (s_currentMarker.empty())
+                return;
+            std::error_code ec;
+            std::filesystem::remove(s_currentMarker, ec);
+            s_currentMarker.clear();
+        } catch (...) {
+            // Process is exiting; the marker remaining merely yields a conservative
+            // postmortem on next launch, which is preferable to risking shutdown.
+        }
+    }
+
+    void OnProcessDetach() noexcept
+    {
+        if (s_abnormal.load(std::memory_order_relaxed) || s_currentMarker.empty())
+            return;
+        // Raw Win32 only: DllMain owns the loader lock here. No filesystem traversal,
+        // formatting or allocation. A failed deletion is harmless and will be
+        // reported conservatively as an unclean session next launch.
+        DeleteFileW(s_currentMarker.c_str());
+    }
+}
diff --git a/src/ThreadInfo.cpp b/src/ThreadInfo.cpp
index 5d820d5..fa71d19 100644
--- a/src/ThreadInfo.cpp
+++ b/src/ThreadInfo.cpp
@@ -88,8 +88,15 @@ namespace ThreadInfo
         const int n = WideCharToMultiByte(CP_UTF8, 0, w, -1, nullptr, 0, nullptr, nullptr);
         if (n <= 1)
             return {};
-        std::string s(static_cast<std::size_t>(n - 1), '\0');
-        WideCharToMultiByte(CP_UTF8, 0, w, -1, s.data(), n, nullptr, nullptr);
+        // WideCharToMultiByte includes the trailing NUL in `n`. Reserve an actual
+        // byte for it; writing `n` bytes into an n-1 sized string is undefined
+        // behaviour and became much easier to hit once all-thread snapshots began
+        // describing many threads per report.
+        std::string s(static_cast<std::size_t>(n), '\0');
+        const int written = WideCharToMultiByte(CP_UTF8, 0, w, -1, s.data(), n, nullptr, nullptr);
+        if (written <= 1)
+            return {};
+        s.resize(static_cast<std::size_t>(written - 1));
         return s;
     }
 
diff --git a/b/src/ThreadSnapshot.cpp b/src/ThreadSnapshot.cpp
new file mode 100644
index 0000000..bcd32ba
--- /dev/null
+++ b/src/ThreadSnapshot.cpp
@@ -0,0 +1,84 @@
+#include "PCH.h"
+#include "ThreadSnapshot.h"
+#include "ThreadInfo.h"
+
+#include <TlHelp32.h>
+
+namespace ThreadSnapshot
+{
+    ThreadSnapshotResult Capture(std::uint32_t excludedThreadId,
+                                 std::size_t maxThreads,
+                                 std::size_t maxFrames)
+    {
+        ThreadSnapshotResult result;
+        if (maxThreads == 0 || maxFrames == 0)
+            return result;
+
+        constexpr std::size_t kHardMaxFrames = 64;
+        maxFrames = (std::min)(maxFrames, kHardMaxFrames);
+
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snap == INVALID_HANDLE_VALUE)
+            return result;
+
+        const DWORD pid        = GetCurrentProcessId();
+        const DWORD currentTid = GetCurrentThreadId();
+
+        THREADENTRY32 te{};
+        te.dwSize = sizeof(te);
+        if (!Thread32First(snap, &te)) {
+            CloseHandle(snap);
+            return result;
+        }
+
+        do {
+            if (te.th32OwnerProcessID != pid)
+                continue;
+            if (te.th32ThreadID == excludedThreadId || te.th32ThreadID == currentTid)
+                continue;
+
+            ++result.candidates;
+            if (result.threads.size() >= maxThreads) {
+                result.truncated = true;
+                continue;
+            }
+
+            HANDLE thread = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT |
+                                       THREAD_QUERY_LIMITED_INFORMATION,
+                                       FALSE, te.th32ThreadID);
+            if (!thread) {
+                ++result.failed;
+                continue;
+            }
+
+            std::array<std::uint64_t, kHardMaxFrames> raw{};
+            std::size_t count = 0;
+            bool captured = false;
+
+            if (SuspendThread(thread) != static_cast<DWORD>(-1)) {
+                CONTEXT ctx{};
+                ctx.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+                if (GetThreadContext(thread, &ctx)) {
+                    count = StackWalker::Unwind(&ctx, raw.data(), maxFrames);
+                    captured = count != 0;
+                }
+                ResumeThread(thread); // resume before allocations / strings / logging
+            }
+            CloseHandle(thread);
+
+            if (!captured) {
+                ++result.failed;
+                continue;
+            }
+
+            ThreadStackSnapshot ts;
+            ts.threadId    = te.th32ThreadID;
+            ts.description = ThreadInfo::Describe(te.th32ThreadID);
+            ts.addresses.assign(raw.begin(), raw.begin() + static_cast<std::ptrdiff_t>(count));
+            result.threads.push_back(std::move(ts));
+        } while (Thread32Next(snap, &te));
+
+        CloseHandle(snap);
+        return result;
+    }
+}
