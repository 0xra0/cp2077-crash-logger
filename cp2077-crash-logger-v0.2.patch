index 0000000..b26708c
--- /dev/null
+++ b/include/ResourceMonitor.h
@@ -0,0 +1,20 @@
+#pragma once
+
+// -----------------------------------------------------------------------------
+// ResourceMonitor — records resource pressure *before* a crash.
+//
+// Sampling memory only after an allocation failure can be too late: the system may
+// already have reclaimed memory or the rich crash writer itself may be unable to
+// allocate.  A tiny watchdog therefore keeps atomics with the last/peak/minimum
+// values and emits durable breadcrumbs when commit, RAM, handles or disk space
+// enter dangerous territory.
+// -----------------------------------------------------------------------------
+
+namespace ResourceMonitor
+{
+    void Start();
+
+    // Pre-render the latest/peak resource state from atomic samples.  No filesystem
+    // access and no process enumeration happens here; suitable for crash reports.
+    std::string Report();
+}
diff --git a/b/include/SessionRecovery.h b/include/SessionRecovery.h
new file mode 100644
index 0000000..891e9a4
--- /dev/null
+++ b/include/SessionRecovery.h
@@ -0,0 +1,29 @@
+#pragma once
+
+// -----------------------------------------------------------------------------
+// SessionRecovery — next-launch evidence for crashes that cannot be caught in the
+// dying process (raw __fastfail/int 29h, driver reset, SIGKILL, Wine termination,
+// power loss, or a crash before the rich writer completes).
+//
+// Each run owns a tiny <pid>.active marker. Clean shutdown removes it. On the next
+// run, stale markers are correlated with CDPR's native
+// %LOCALAPPDATA%\REDEngine\ReportQueue and a self-contained postmortem is made.
+// -----------------------------------------------------------------------------
+
+namespace SessionRecovery
+{
+    // Analyze stale markers from previous runs and arm the marker for this run.
+    // Deferred-init thread only; performs filesystem I/O.
+    void Init();
+
+    // Allocation-free state bit set as soon as CrashHandler commits to a crash.
+    void MarkAbnormal() noexcept;
+
+    // Called from known clean process-exit hooks. Best-effort.
+    void MarkCleanExit() noexcept;
+
+    // Loader-lock-safe shutdown fallback. DLL_PROCESS_DETACH is also reached when
+    // WinMain simply returns, a path that need not import ExitProcess at all.
+    // The marker is removed only when MarkAbnormal() was never set.
+    void OnProcessDetach() noexcept;
+}
diff --git a/b/include/ThreadSnapshot.h b/include/ThreadSnapshot.h
new file mode 100644
index 0000000..0d80212
--- /dev/null
+++ b/include/ThreadSnapshot.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "StackWalker.h"
+
+// -----------------------------------------------------------------------------
+// ThreadSnapshot — raw unwind snapshots of the *other* threads in the process.
+//
+// A crashing thread tells us where the fault surfaced, but deadlocks, worker-pool
+// failures and cross-thread lifetime bugs often leave the useful evidence on a
+// different thread.  The capture path suspends one thread at a time only long
+// enough to copy CONTEXT + unwind addresses, resumes it immediately, and performs
+// every allocation afterwards.  That avoids the classic reporter deadlock where a
+// suspended victim owns the CRT heap or dbghelp lock.
+// -----------------------------------------------------------------------------
+
+struct ThreadStackSnapshot
+{
+    std::uint32_t              threadId{};
+    std::string                description;
+    std::vector<std::uint64_t> addresses;
+};
+
+struct ThreadSnapshotResult
+{
+    std::vector<ThreadStackSnapshot> threads;
+    std::size_t                      candidates{};
+    std::size_t                      failed{};
+    bool                             truncated{};
+};
+
+namespace ThreadSnapshot
+{
+    // Capture all process threads except `excludedThreadId` and the caller.  Each
+    // thread is resumed before any vector/string work is performed.
+    ThreadSnapshotResult Capture(std::uint32_t excludedThreadId,
+                                 std::size_t maxThreads = 48,
+                                 std::size_t maxFrames = 24);
+}
